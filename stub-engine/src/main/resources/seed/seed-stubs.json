[
  {
    "stub_id": "stub_account_create_v1",
    "description": "Open a USD account. Client-supplied account_id is honoured, otherwise one is generated per session.",
    "tags": ["core-banking", "accounts"],
    "request_matcher": {
      "protocol": "HTTP", "method": "POST", "path": "/api/v1/accounts",
      "body_jsonpath": { "$.currency": "USD" }
    },
    "response_template": {
      "status_code": 201,
      "headers": { "Location": "/api/v1/accounts/{{response.body.account_id}}" },
      "body": {
        "account_id": "{{request.body.account_id ?: generate.id:ACC}}",
        "account_holder": "{{request.body.account_holder}}",
        "balance": "{{request.body.initial_deposit ?: 0}}",
        "currency": "{{request.body.currency}}",
        "status": "ACTIVE"
      }
    },
    "state_action": { "op": "PUT", "collection": "accounts", "key": "{{response.body.account_id}}", "value": "{{response.body}}" }
  },
  {
    "stub_id": "stub_account_create_rejected_v1",
    "description": "Fallback for account creation in any currency other than USD (or none).",
    "priority": -1,
    "tags": ["core-banking", "accounts", "negative"],
    "request_matcher": { "protocol": "HTTP", "method": "POST", "path": "/api/v1/accounts" },
    "response_template": {
      "status_code": 422,
      "body": { "error": "UNSUPPORTED_CURRENCY", "currency": "{{request.body.currency}}", "supported": ["USD"] }
    }
  },
  {
    "stub_id": "stub_account_get_v1",
    "description": "Read an account created earlier in the same session.",
