    "response_template": { "status_code": 200 },
    "state_action": { "op": "GET", "collection": "accounts", "key": "{{request.path.id}}" },
    "not_found_response": {
      "status_code": 404,
      "body": { "error": "ACCOUNT_NOT_FOUND", "account_id": "{{request.path.id}}" }
    }
  },
  {
    "stub_id": "stub_account_summary_v1",
