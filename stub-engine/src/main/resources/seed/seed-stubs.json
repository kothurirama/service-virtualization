  },
  {
    "stub_id": "stub_payment_high_risk_v1",
    "description": "Regex on merchant id routes high-risk merchants to manual review.",
    "priority": 10,
    "tags": ["payments"],
    "request_matcher": {
      "protocol": "HTTP", "method": "POST", "path": "/api/v1/payments",
      "body_jsonpath": { "$.merchant_id": { "matches": "^MERCH_9\\d{3}$" } }
    },
    "response_template": {
      "status_code": 202,
      "body": { "status": "PENDING_REVIEW", "reason": "HIGH_RISK_MERCHANT", "merchant_id": "{{request.body.merchant_id}}" }
    }
  },
  {
    "stub_id": "stub_payment_large_amount_v1",
    "description": "Numeric comparison: payments above 10,000 need review.",
    "priority": 5,
    "tags": ["payments"],
    "request_matcher": {
      "protocol": "HTTP", "method": "POST", "path": "/api/v1/payments",
      "body_jsonpath": { "$.amount": { "gt": 10000 } }
    },
    "response_template": {
      "status_code": 202,
      "body": { "status": "PENDING_REVIEW", "reason": "LARGE_AMOUNT", "amount": "{{request.body.amount}}" }
    }
  },
