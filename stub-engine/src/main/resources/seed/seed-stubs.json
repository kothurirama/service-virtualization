  {
    "stub_id": "stub_payment_sanctioned_v1",
    "description": "Deep scan: a sanctioned country anywhere in the payload is blocked.",
    "priority": 20,
    "tags": ["payments", "negative"],
    "request_matcher": {
      "protocol": "HTTP", "method": "POST", "path": "/api/v1/payments",
      "body_jsonpath": { "$..country": "KP" }
