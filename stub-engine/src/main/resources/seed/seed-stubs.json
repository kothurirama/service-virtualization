  {
    "stub_id": "stub_account_list_v1",
    "description": "List all accounts in the session.",
    "tags": ["core-banking", "accounts"],
    "request_matcher": { "protocol": "HTTP", "method": "GET", "path": "/api/v1/accounts" },
    "response_template": {
      "status_code": 200,
      "body": { "items": "{{state.values}}", "count": "{{state.count}}" }
    },
    "state_action": { "op": "LIST", "collection": "accounts" }
  },
  {
    "stub_id": "stub_account_update_v1",
